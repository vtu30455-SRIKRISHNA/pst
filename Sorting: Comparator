import java.io.*;
import java.util.*;

// 1. Define the Player class structure
class Player {
    String name;
    int score;

    Player(String name, int score) {
        this.name = name;
        this.score = score;
    }
}

// 2. Define the Checker comparator logic
class Checker implements Comparator<Player> {
    @Override
    public int compare(Player a, Player b) {
        // If scores are equal, sort alphabetically by name (ascending)
        if (a.score == b.score) {
            return a.name.compareTo(b.name);
        }
        // Otherwise, sort by score in decreasing order (descending)
        return Integer.compare(b.score, a.score);
    }
}

// 3. The mandatory main entry point class for the platform
public class Solution {

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        if (!scan.hasNextInt()) return;
        int n = scan.nextInt();
        
        Player[] player = new Player[n];
        Checker checker = new Checker();
        
        // Read input tokens for all players
        for (int i = 0; i < n; i++) {
            player[i] = new Player(scan.next(), scan.nextInt());
        }
        scan.close();

        // Sort the array using the custom comparator rules
        Arrays.sort(player, checker);
        
        // Print output formatted exactly as required
        for (int i = 0; i < player.length; i++) {
            System.out.printf("%s %s\n", player[i].name, player[i].score);
        }
    }
}
