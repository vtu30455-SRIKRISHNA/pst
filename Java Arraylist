import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        
        int n = scan.nextInt();
        ArrayList<ArrayList<Integer>> lines = new ArrayList<>();
        
        // Read each line and store elements in a nested ArrayList
        for (int i = 0; i < n; i++) {
            int d = scan.nextInt();
            ArrayList<Integer> row = new ArrayList<>();
            for (int j = 0; j < d; j++) {
                row.add(scan.nextInt());
            }
            lines.add(row);
        }
        
        // Process queries
        int q = scan.nextInt();
        for (int i = 0; i < q; i++) {
            int x = scan.nextInt(); // 1-indexed line number
            int y = scan.nextInt(); // 1-indexed element position
            
            // Check bounds by converting to 0-indexed values
            if (x - 1 >= 0 && x - 1 < lines.size() && y - 1 >= 0 && y - 1 < lines.get(x - 1).size()) {
                System.out.println(lines.get(x - 1).get(y - 1));
            } else {
                System.out.println("ERROR!");
            }
        }
        
        scan.close();
    }
}
