class Solution {
    public int[] runningSum(int[] nums) {
        // Start from index 1 because index 0 is already its own running sum
        for (int i = 1; i < nums.length; i++) {
            // Add the previous element's accumulated running sum to the current element
            nums[i] += nums[i - 1];
        }
        return nums;
    }
}
